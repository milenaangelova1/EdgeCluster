     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 2, 3]\n",
      "[2, 3, 4]\n",
      "[3, 4, 5]\n",
      "[4, 5, 6]\n",
      "[5, 6, 7]\n",
      "[6, 7, 8]\n",
      "[7, 8]\n",
      "[8]\n"
     ]
    }
   ],
   "source": [
    "\n",
    "sliding_window(lst, 3)"
   ]
  }
 ],
