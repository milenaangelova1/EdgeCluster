   "source": [
    "lst = [1,2,3,4,5,6,7,8] \n",
    "def sliding_window(elements, window_size):\n",
    "    \n",
    "    if len(elements) <= window_size:\n",
    "       return elements\n",
    "    for i in range(len(elements)):\n",
    "        print(elements[i:i+window_size])"
   ]
  },
